{
  "name": "localmate-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:articles": "node scripts/build-articles-data.js",
    "prebuild": "node scripts/build-articles-data.js && node scripts/generate-seo-files.js",
    "build": "tsc && vite build && node scripts/generate-static-routes.js",
    "preview": "vite preview",
    "seo:generate": "node scripts/generate-seo-files.js",
    "db:migrate": "npx wrangler d1 execute localmate_survey_db --remote --file=./migrations/0001_cms_init.sql && npx wrangler d1 execute localmate_survey_db --remote --file=./migrations/0002_cms_defaults.sql",
    "cms:seed": "node scripts/generate-seeds.js && node scripts/seed-cms.js && npx wrangler d1 execute localmate_survey_db --remote --file=./migrations/0003_seed_draft_posts.sql",
    "submit:indexnow": "node scripts/submit-indexnow.js"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "hono": "^4.13.8",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
